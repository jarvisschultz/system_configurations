#!/usr/bin/env bash
# git wtclean [-n]
#
# Remove linked worktrees whose branch's upstream is gone (MR merged and
# source branch deleted, then `git fetch --prune`), and delete the branch.
# A worktree is only a candidate when:
#   - it is not the main worktree and not the one you are standing in
#   - `git status --ignore-submodules=none` is empty: no modified, staged or
#     untracked files, in the worktree or inside any submodule, and no
#     submodule moved off its recorded commit
#   - every initialized submodule has no stash and no commit (on HEAD or a
#     local branch) that is missing from its remotes
#
# Git refuses to remove any worktree with initialized submodules, clean or
# not (even after `submodule deinit`), and removing one with --force deletes
# the submodules' git dirs under .git/worktrees/<name>/modules. So a
# worktree with submodules is removed with --force only after the checks
# above. A single --force still refuses locked worktrees.
#
# -n  list what would be removed and why others were skipped, then exit.
# Otherwise it lists, asks once, and removes on "y".
set -uo pipefail

dry=0
[[ ${1:-} == -n ]] && dry=1

main_wt=$(git worktree list --porcelain | sed -n '1s/^worktree //p')
here=$(git rev-parse --show-toplevel)

names=() paths=() shas=()
while IFS=$'\t' read -r branch wt; do
    [[ -z $wt ]] && continue                 # not in a worktree: `git bdorph`
    if [[ $wt == "$main_wt" ]]; then echo "skip  $branch  (main worktree)"; continue; fi
    if [[ $wt == "$here" ]]; then echo "skip  $branch  (current worktree)"; continue; fi
    if [[ ! -d $wt ]]; then echo "skip  $branch  ($wt missing; run git worktree prune)"; continue; fi
    if [[ -n $(git -C "$wt" status --porcelain --ignore-submodules=none 2>/dev/null | head -1) ]]; then
        echo "skip  $branch  (dirty: $wt)"; continue
    fi
    # Submodule git dirs are deleted with the worktree; refuse if they hold
    # anything that exists nowhere else.
    at_risk=$(git -C "$wt" submodule foreach --quiet --recursive '
        if [ -n "$(git rev-list -1 HEAD --branches --not --remotes)" ]; then
            echo "$displaypath: unpushed commits"
        elif [ -n "$(git stash list | head -1)" ]; then
            echo "$displaypath: stash"
        fi' 2>&1)
    if [[ -n $at_risk ]]; then
        echo "skip  $branch  (submodule ${at_risk//$'\n'/; })"; continue
    fi
    names+=("$branch") paths+=("$wt") shas+=("$(git rev-parse --short "refs/heads/$branch")")
done < <(git for-each-ref \
    --format='%(if:equals=[gone])%(upstream:track)%(then)%(refname:short)%09%(worktreepath)%(end)' \
    refs/heads | sed '/^$/d')

if (( ${#names[@]} == 0 )); then echo "nothing to clean"; exit 0; fi

for i in "${!names[@]}"; do echo "clean ${names[i]}  ${shas[i]}  ${paths[i]}"; done
(( dry )) && exit 0

read -r -p "Remove these ${#names[@]} worktrees and delete their branches? [y/N] " ans </dev/tty
[[ $ans == [yY] ]] || { echo "aborted"; exit 1; }

for i in "${!names[@]}"; do
    force=()
    [[ -n $(git -C "${paths[i]}" submodule status --recursive 2>/dev/null | grep -v '^-') ]] && force=(--force)
    if git worktree remove "${force[@]}" "${paths[i]}"; then
        git branch -D "${names[i]}"
        # Recoverable until gc: git branch <name> <sha>
        echo "removed ${names[i]} (was ${shas[i]})"
    else
        echo "left    ${names[i]} (worktree remove refused)"
    fi
done
